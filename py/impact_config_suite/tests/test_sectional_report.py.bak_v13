"""Tests for core.sectional_report - section scoping and unique keys."""
from __future__ import annotations

import csv
import json
import tempfile
import unittest
from pathlib import Path

from core import sectional_report as sr


SAMPLE_XML = """<?xml version="1.0" encoding="UTF-8"?>
<article xmlns:xlink="http://www.w3.org/1999/xlink">
  <front>
    <article-meta>
      <article-id pub-id-type="doi">10.1000/front-doi</article-id>
      <ext-link ext-link-type="uri" xlink:href="https://example.com/front">Front URI</ext-link>
      <uri>https://example.com/front-uri</uri>
    </article-meta>
  </front>
  <body>
    <p>
      <ext-link ext-link-type="doi" xlink:href="https://doi.org/10.1000/body-doi">10.1000/body-doi</ext-link>
      <ext-link ext-link-type="uri" xlink:href="https://example.com/body">Body link</ext-link>
    </p>
  </body>
  <back>
    <ref-list>
      <ref>
        <pub-id pub-id-type="doi">10.1000/ref-doi</pub-id>
        <ext-link ext-link-type="doi" xlink:href="https://doi.org/10.1000/ref-ext">10.1000/ref-ext</ext-link>
        <uri>https://example.com/ref-uri</uri>
      </ref>
    </ref-list>
    <app-group>
      <app>
        <p>
          <pub-id pub-id-type="doi">10.1000/other-doi</pub-id>
          <ext-link ext-link-type="uri" xlink:href="https://example.com/other">Other</ext-link>
        </p>
      </app>
    </app-group>
    <fn-group>
      <fn>
        <p>
          <ext-link ext-link-type="uri" xlink:href="https://doi.org/10.1000/fn-uri">fn link</ext-link>
        </p>
      </fn>
    </fn-group>
  </back>
</article>
"""

# Two docs with different hrefs but same tag+type+section - must merge.
SAMPLE_XML_A = """<?xml version="1.0" encoding="UTF-8"?>
<article>
  <front><article-meta>
    <ext-link ext-link-type="uri" href="https://aaa.example/1">A1</ext-link>
  </article-meta></front>
  <body><p>x</p></body>
  <back><ref-list><ref><p>r</p></ref></ref-list></back>
</article>
"""

SAMPLE_XML_B = """<?xml version="1.0" encoding="UTF-8"?>
<article>
  <front><article-meta>
    <ext-link ext-link-type="uri" href="https://bbb.example/2">B2</ext-link>
  </article-meta></front>
  <body><p>y</p></body>
  <back><ref-list><ref><p>r</p></ref></ref-list></back>
</article>
"""


BITS_SAMPLE_XML = """<?xml version="1.0" encoding="UTF-8"?>
<book xmlns:xlink="http://www.w3.org/1999/xlink">
  <front-matter>
    <book-meta>
      <book-id book-id-type="doi">10.1000/bits-front-doi</book-id>
    </book-meta>
    <uri>https://example.com/bits-front-uri</uri>
  </front-matter>
  <book-body>
    <book-part>
      <body>
        <p>
          <ext-link ext-link-type="uri" xlink:href="https://example.com/bits-body">Body</ext-link>
        </p>
      </body>
      <back>
        <ref-list>
          <ref>
            <ext-link ext-link-type="doi" xlink:href="https://doi.org/10.1000/bits-ref">10.1000/bits-ref</ext-link>
          </ref>
        </ref-list>
        <ack>
          <p>thanks</p>
        </ack>
      </back>
    </book-part>
  </book-body>
</book>
"""


BITS_BOOK_BACK_XML = """<?xml version="1.0" encoding="UTF-8"?>
<book xmlns:xlink="http://www.w3.org/1999/xlink">
  <front-matter>
    <book-meta>
      <book-id book-id-type="doi">10.1000/bits-bb-front</book-id>
    </book-meta>
  </front-matter>
  <book-body>
    <book-part>
      <body><p>chapter</p></body>
    </book-part>
  </book-body>
  <book-back>
    <ref-list>
      <ref>
        <ext-link ext-link-type="doi" xlink:href="https://doi.org/10.1000/book-back-ref">10.1000/book-back-ref</ext-link>
      </ref>
    </ref-list>
    <fn-group>
      <fn><p>note</p></fn>
    </fn-group>
    <app-group>
      <app><p>app text</p></app>
    </app-group>
    <ack><p>book-back residual ack</p></ack>
  </book-back>
</book>
"""


class TestSectionalReport(unittest.TestCase):
    def setUp(self):
        self._prev_root = sr.REPORT_ROOT
        self._tmpdir = tempfile.TemporaryDirectory()
        self.tmp = Path(self._tmpdir.name)
        sr.REPORT_ROOT = self.tmp / "reports"

    def tearDown(self):
        sr.REPORT_ROOT = self._prev_root
        self._tmpdir.cleanup()

    def _write(self, name: str, content: str) -> Path:
        p = self.tmp / name
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(content, encoding="utf-8")
        return p

    def test_section_counts_and_ref_vs_other_scoping(self):
        xml = self._write("doc1.xml", SAMPLE_XML)
        result = sr.extract_file(xml)

        self.assertIsNone(result["error"])
        self.assertEqual(result["section_counts"]["FRONT"], 1)
        self.assertEqual(result["section_counts"]["BODY"], 1)
        self.assertEqual(result["section_counts"]["REF"], 1)
        # N4012a14b-style: only fn-group + app-group under back -> OTHER residual 0
        self.assertEqual(result["section_counts"]["OTHER"], 0)
        self.assertEqual(result["section_counts"]["FOOTNOTES"], 1)
        self.assertGreaterEqual(result["section_counts"]["APPENDIX"], 1)

        # REF gets ref-list DOIs; APPENDIX owns app DOI (not OTHER)
        self.assertEqual(result["per_section"]["REF"]["doi_id"]["count"], 1)
        self.assertEqual(result["per_section"]["OTHER"]["doi_id"]["count"], 0)
        self.assertGreaterEqual(result["per_section"]["APPENDIX"]["doi_id"]["count"], 1)
        ref_texts = [h["text"] for h in result["per_section"]["REF"]["doi_id"]["hits"]]
        app_texts = [h["text"] for h in result["per_section"]["APPENDIX"]["doi_id"]["hits"]]
        self.assertTrue(any("ref-doi" in t for t in ref_texts))
        self.assertTrue(any("other-doi" in t for t in app_texts))
        self.assertFalse(any("other-doi" in t for t in ref_texts))
        self.assertFalse(any("ref-doi" in t for t in app_texts))

        # FRONT doi_id
        self.assertEqual(result["per_section"]["FRONT"]["doi_id"]["count"], 1)
        # BODY extlink_doi
        self.assertEqual(result["per_section"]["BODY"]["extlink_doi"]["count"], 1)
        # REF also has extlink_doi
        self.assertEqual(result["per_section"]["REF"]["extlink_doi"]["count"], 1)

        # Aggregate query totals = sum across ALL sections (incl. FOOTNOTES/APPENDIX).
        # OTHER no longer overlaps APPENDIX/FOOTNOTES at the root level.
        self.assertEqual(
            result["query_totals"]["doi_id"],
            sum(result["per_section"][s]["doi_id"]["count"] for s in sr.SECTIONS),
        )
        # FRONT1 + REF1 + APPENDIX(app-group and/or app) >= 3
        self.assertGreaterEqual(result["query_totals"]["doi_id"], 3)

    def test_tsv_headers_and_row_sums(self):
        xml = self._write("folder/a.xml", SAMPLE_XML)
        out = sr.run_sectional_report(xml.parent, folder_mode=True, log=lambda m: None)
        tsv = Path(out["tsv_path"])
        self.assertTrue(tsv.is_file())
        with open(tsv, encoding="utf-8", newline="") as f:
            reader = csv.reader(f, delimiter="\t")
            headers = next(reader)
            row = next(reader)
        self.assertEqual(headers, sr.TSV_HEADERS)
        # Client empty in flat folder mode; File_id_Docid = stem when no meta
        self.assertEqual(row[0], "")  # Client
        self.assertEqual(row[1], "a")  # File_id_Docid (stem only)
        # FRONT BODY REF OTHER FootNotes Appendix
        self.assertEqual(int(row[2]), 1)   # FRONT
        self.assertEqual(int(row[3]), 1)   # BODY
        self.assertEqual(int(row[4]), 1)   # REF
        self.assertEqual(int(row[5]), 0)   # OTHER residual 0 (fn-group+app owned elsewhere)
        self.assertEqual(int(row[6]), 1)   # FootNotes (fn-group)
        self.assertGreaterEqual(int(row[7]), 1)  # Appendix (app-group and/or app)
        # query cols
        self.assertGreaterEqual(int(row[8]), 3)  # doi_id: FRONT+REF+APPENDIX (no OTHER overlap)
        self.assertGreaterEqual(int(row[9]), 1)  # extlink_doi
        self.assertGreaterEqual(int(row[10]), 1)  # extlink_uri
        self.assertGreaterEqual(int(row[11]), 1)  # uri

    def test_client_unique_merges_without_href(self):
        a = self._write("proj/JATS/D1/doc.xml", SAMPLE_XML_A)
        b = self._write("proj/JATS/D2/doc.xml", SAMPLE_XML_B)
        # Build minimal project
        proj = self.tmp / "proj"
        docs = {
            "D1": {"folder": "JATS/D1", "files": {"xml": "JATS/D1/doc.xml"}},
            "D2": {"folder": "JATS/D2", "files": {"xml": "JATS/D2/doc.xml"}},
        }
        metas = {
            "D1": {
                "dtd": "JATS",
                "client": "ClientX",
                "project-shortcode": "SC1",
                "file-id": "F1",
            },
            "D2": {
                "dtd": "JATS",
                "client": "ClientX",
                "project-shortcode": "SC1",
                "file-id": "F2",
            },
        }

        (proj / "documents.json").write_text(json.dumps(docs), encoding="utf-8")
        (proj / "meta.json").write_text(json.dumps(metas), encoding="utf-8")

        out = sr.run_sectional_report(proj, log=lambda m: None)
        self.assertEqual(out["n_files"], 2)
        rows = out["rows"]
        self.assertEqual(rows[0]["file_id"], "F1")
        self.assertEqual(rows[1]["file_id"], "F2")

        merged = sr._merge_client_unique(rows)
        self.assertIn("ClientX", merged)
        # Both FRONT ext-link uri should be one bucket despite different hrefs
        front_uri = [
            e
            for e in merged["ClientX"]
            if e["section"] == "FRONT"
            and e["tag"] == "ext-link"
            and e["type_attr"] == "ext-link-type"
            and e["type_value"] == "uri"
        ]
        self.assertEqual(len(front_uri), 1)
        self.assertEqual(front_uri[0]["count"], 2)
        self.assertEqual(sorted(front_uri[0]["sample_docids"]), ["D1", "D2"])

        # CSV exists and has no href column
        cu_csv = Path(out["client_unique_csv"])
        with open(cu_csv, encoding="utf-8", newline="") as f:
            headers = next(csv.reader(f))
        self.assertNotIn("href", headers)
        self.assertIn("type_attr", headers)
        self.assertIn("section", headers)

    def test_missing_file_id_still_emits_docid(self):
        xml = self._write("lonely.xml", SAMPLE_XML)
        result = sr.extract_file(xml)
        out_rows = [
            {
                "docid": "lonely",
                "file_id": "",
                "client": "",
                "shortcode": "",
                **result,
            }
        ]
        tsv = sr.write_tsv(out_rows, self.tmp / "out.tsv")
        with open(tsv, encoding="utf-8", newline="") as f:
            rows = list(csv.reader(f, delimiter="\t"))
        self.assertEqual(rows[1][0], "")  # Client
        self.assertEqual(rows[1][1], "lonely")  # File_id_Docid falls back to docid

    def test_bits_front_matter_and_ref_scoping(self):
        """BITS book: front-matter counts as FRONT; doi ext-link under ref-list is REF not OTHER."""
        xml = self._write("bits_book.xml", BITS_SAMPLE_XML)
        result = sr.extract_file(xml)

        self.assertIsNone(result["error"])
        # front-matter (+ nested book-meta also matches FRONT roots set)
        self.assertGreaterEqual(result["section_counts"]["FRONT"], 1)
        self.assertGreaterEqual(result["section_counts"]["BODY"], 1)
        self.assertEqual(result["section_counts"]["REF"], 1)
        self.assertEqual(result["section_counts"]["OTHER"], 1)  # ack under back

        # uri under front-matter counts under FRONT
        self.assertGreaterEqual(result["per_section"]["FRONT"]["uri"]["count"], 1)
        front_uri_texts = [h["text"] for h in result["per_section"]["FRONT"]["uri"]["hits"]]
        self.assertTrue(any("bits-front-uri" in t for t in front_uri_texts))

        # doi ext-link under ref-list -> REF, not OTHER
        self.assertEqual(result["per_section"]["REF"]["extlink_doi"]["count"], 1)
        self.assertEqual(result["per_section"]["OTHER"]["extlink_doi"]["count"], 0)
        ref_texts = [h["text"] for h in result["per_section"]["REF"]["extlink_doi"]["hits"]]
        self.assertTrue(any("bits-ref" in t for t in ref_texts))

    def test_footnotes_and_appendix_sections(self):
        """fn-group -> FOOTNOTES; app-group/app -> APPENDIX; OTHER excludes both."""
        xml = self._write("fn_app.xml", SAMPLE_XML)
        result = sr.extract_file(xml)
        self.assertIsNone(result["error"])
        self.assertEqual(result["section_counts"]["FOOTNOTES"], 1)
        # app-group + nested app both match APPENDIX selectors
        self.assertGreaterEqual(result["section_counts"]["APPENDIX"], 1)
        # OTHER residual excludes fn-group and appendix-like roots
        self.assertEqual(result["section_counts"]["OTHER"], 0)
        # query under footnotes: extlink_uri with doi.org
        self.assertGreaterEqual(result["per_section"]["FOOTNOTES"]["extlink_uri"]["count"], 1)
        fn_hits = result["per_section"]["FOOTNOTES"]["extlink_uri"]["hits"]
        self.assertTrue(any(h.get("doi_org_in_href") for h in fn_hits))
        # appendix gets the other-doi pub-id; OTHER must not
        self.assertGreaterEqual(result["per_section"]["APPENDIX"]["doi_id"]["count"], 1)
        self.assertEqual(result["per_section"]["OTHER"]["doi_id"]["count"], 0)

    def test_report_version_and_html_filters(self):
        self.assertEqual(sr.REPORT_VERSION, 13)
        xml = self._write("folder/b.xml", SAMPLE_XML)
        # synthetic meta-bearing row via project
        proj = self.tmp / "proj_filters"
        proj.mkdir()
        doc_path = proj / "JATS" / "D9"
        doc_path.mkdir(parents=True)
        (doc_path / "doc.xml").write_text(SAMPLE_XML, encoding="utf-8")
        docs = {"D9": {"folder": "JATS/D9", "files": {"xml": "JATS/D9/doc.xml"}}}
        metas = {
            "D9": {
                "dtd": "JATS",
                "client": "TNF",
                "project-shortcode": "pubkittnf",
                "file-id": "67053_test",
                "type": "Books",
            }
        }
        (proj / "documents.json").write_text(json.dumps(docs), encoding="utf-8")
        (proj / "meta.json").write_text(json.dumps(metas), encoding="utf-8")
        out = sr.run_sectional_report(proj, log=lambda m: None)
        html = Path(out["html_path"]).read_text(encoding="utf-8")
        self.assertIn("filterClient", html)
        self.assertIn('data-client="TNF"', html)
        self.assertIn("Open HTML", html)
        self.assertIn("Copy Path", html)
        self.assertIn("File-id / Docid", html)
        self.assertIn("67053_test", html)
        self.assertIn("FOOTNOTES", html)
        self.assertIn("APPENDIX", html)
        # Slim UI: no DOI-port extra filters
        self.assertNotIn("filterDocType", html)
        self.assertNotIn("filterProjectShortcode", html)
        self.assertNotIn("filterElementKind", html)
        self.assertNotIn("filterIdentifier", html)
        self.assertNotIn("filterUnderComment", html)
        self.assertNotIn("filterDoiOrgHref", html)
        self.assertNotIn("(no meta)", html)
        # folder mode still works with empty filters
        out2 = sr.run_sectional_report(xml.parent, folder_mode=True, log=lambda m: None)
        self.assertGreaterEqual(out2["n_files"], 1)
        html2 = Path(out2["html_path"]).read_text(encoding="utf-8")
        self.assertIn("filterClient", html2)
        self.assertNotIn("filterProjectShortcode", html2)

    def test_folder_meta_json_fills_client(self):
        """BITS-style tree: meta.json at DTD root fills client without documents.json."""
        bits = self.tmp / "BITS"
        docid = "N00013009-f0f8-49df-81b6-0bad52d03d80"
        doc_dir = bits / docid
        doc_dir.mkdir(parents=True)
        (doc_dir / "book.xml").write_text(BITS_SAMPLE_XML, encoding="utf-8")
        metas = {
            docid: {
                "file-id": "9781041023784_reverted_impact",
                "client": "TNF",
                "project-shortcode": "IPT",
                "type": "Books",
                "dtd": "BITS",
            }
        }
        (bits / "meta.json").write_text(json.dumps(metas), encoding="utf-8")
        docs = sr.collect_docs(bits, folder_mode=True)
        self.assertEqual(len(docs), 1)
        self.assertEqual(docs[0]["client"], "TNF")
        self.assertEqual(docs[0]["docid"], docid)
        self.assertEqual(docs[0]["file_id"], "9781041023784_reverted_impact")
        self.assertEqual(
            sr._combined_id_text(docs[0]["file_id"], docs[0]["docid"]),
            f"9781041023784_reverted_impact\n{docid}",
        )
        out = sr.run_sectional_report(bits, folder_mode=True, log=lambda m: None)
        html = Path(out["html_path"]).read_text(encoding="utf-8")
        self.assertIn('data-client="TNF"', html)
        self.assertIn("<option value=\"TNF\">TNF</option>", html)
        tsv = Path(out["tsv_path"]).read_text(encoding="utf-8")
        self.assertIn("TNF", tsv)
        self.assertIn("9781041023784_reverted_impact", tsv)
        self.assertIn(
            f"<td><div>9781041023784_reverted_impact</div><div><small>{docid}</small></div></td>",
            html,
        )

    def test_other_excludes_fn_group_and_appendix_roots(self):
        """OTHER roots are residual back children only - never fn-group or app*."""
        xml = self._write("other_exclude.xml", SAMPLE_XML)
        root = sr._parse_xml(xml)
        roots = sr._section_roots(root)
        other_names = [sr.local_name(el.tag) for el in roots["OTHER"]]
        self.assertEqual(other_names, [])
        fn_names = [sr.local_name(el.tag) for el in roots["FOOTNOTES"]]
        self.assertEqual(fn_names, ["fn-group"])
        app_names = {sr.local_name(el.tag) for el in roots["APPENDIX"]}
        self.assertTrue(app_names & {"app-group", "app"})
        # Guard: OTHER must never list exclusive owners as roots
        forbidden = {"fn-group", "app-group", "book-app-group", "book-app", "app", "ref-list"}
        self.assertFalse(forbidden & set(other_names))

    def test_ref_list_under_book_back(self):
        """REF finds ref-list direct children of book-back; residual ack -> OTHER."""
        xml = self._write("bits_book_back.xml", BITS_BOOK_BACK_XML)
        result = sr.extract_file(xml)
        self.assertIsNone(result["error"])
        self.assertEqual(result["section_counts"]["REF"], 1)
        # fn-group + app-group excluded from OTHER; ack remains residual
        self.assertEqual(result["section_counts"]["OTHER"], 1)
        self.assertEqual(result["section_counts"]["FOOTNOTES"], 1)
        self.assertGreaterEqual(result["section_counts"]["APPENDIX"], 1)
        self.assertEqual(result["per_section"]["REF"]["extlink_doi"]["count"], 1)
        self.assertEqual(result["per_section"]["OTHER"]["extlink_doi"]["count"], 0)
        ref_texts = [h["text"] for h in result["per_section"]["REF"]["extlink_doi"]["hits"]]
        self.assertTrue(any("book-back-ref" in t for t in ref_texts))
        root = sr._parse_xml(xml)
        roots = sr._section_roots(root)
        other_names = [sr.local_name(el.tag) for el in roots["OTHER"]]
        self.assertEqual(other_names, ["ack"])

    def test_other_residual_zero_when_only_fn_and_app_under_back(self):
        """Sample like N4012a14b: OTHER residual 0 when only fn-group+app under back."""
        # SAMPLE_XML back children: ref-list, app-group, fn-group only
        xml = self._write("n4012_like.xml", SAMPLE_XML)
        result = sr.extract_file(xml)
        self.assertEqual(result["section_counts"]["OTHER"], 0)
        self.assertEqual(result["section_counts"]["REF"], 1)
        self.assertEqual(result["section_counts"]["FOOTNOTES"], 1)
        self.assertGreaterEqual(result["section_counts"]["APPENDIX"], 1)

    def test_tsv_has_client_and_combined_id_columns(self):
        self.assertEqual(sr.TSV_HEADERS[0], "Client")
        self.assertEqual(sr.TSV_HEADERS[1], "File_id_Docid")
        self.assertNotIn("Docid", sr.TSV_HEADERS)
        self.assertNotIn("File_id", sr.TSV_HEADERS)
        self.assertNotIn("Shortcode", sr.TSV_HEADERS)
        self.assertNotIn("Doc_type", sr.TSV_HEADERS)
        self.assertIn("FootNotes", sr.TSV_HEADERS)
        self.assertIn("Appendix", sr.TSV_HEADERS)
        self.assertEqual(
            sr._combined_id_text("F1", "D1"),
            "F1\nD1",
        )
        self.assertEqual(
            sr._combined_id_cell("F1", "D1"),
            "<div>F1</div><div><small>D1</small></div>",
        )


    def test_cross_query_inconsistency_and_text_sample_toggle(self):
        per = {
            section: {query: {"count": 0, "hits": []} for query in sr.QUERY_KEYS}
            for section in sr.SECTIONS
        }
        doi = "10.5281/zenodo.17376602"
        per["BODY"]["extlink_doi"] = {
            "count": 1,
            "hits": [{
                "tag": "ext-link",
                "text": f"https://doi.org (https://doi.org/{doi})",
                "href": f"https://doi.org/{doi}",
                "raw_xml": f'<ext-link ext-link-type="doi">{doi}</ext-link>',
            }],
        }
        per["BODY"]["uri"] = {
            "count": 1,
            "hits": [{
                "tag": "uri",
                "text": f"https://doi.org/{doi}",
                "href": "",
                "raw_xml": f"<uri>https://doi.org/{doi}</uri>",
            }],
        }
        row = {
            "client": "ClientA",
            "file_id": "F1",
            "docid": "D1",
            "xml_path": str(self.tmp / "D1.xml"),
            "per_section": per,
            "section_counts": {section: 0 for section in sr.SECTIONS},
            "query_totals": {query: 0 for query in sr.QUERY_KEYS},
            "error": None,
        }
        issues = sr.find_cross_query_inconsistencies([row])
        self.assertEqual(len(issues), 1)
        self.assertEqual(issues[0]["doi"], doi)
        self.assertEqual(set(issues[0]["queries"]), {"extlink_doi", "uri"})

        html_path = sr.write_html_report([row], self.tmp / "sectional.html")
        page = html_path.read_text(encoding="utf-8")
        self.assertIn("Cross-query DOI inconsistencies", page)
        self.assertIn("ClientA", page)
        self.assertIn("HTML Preview", page)
        self.assertIn("Raw XML", page)
        self.assertIn("&lt;ext-link", page)
        self.assertNotIn("View HTML", page)
        self.assertNotIn("View Raw XML", page)
        inc_html, inc_csv = sr.write_inconsistency_report([row], self.tmp / "reports")
        self.assertTrue(inc_html.is_file())
        self.assertTrue(inc_csv.is_file())
        inc_text = inc_html.read_text(encoding="utf-8")
        self.assertIn("ClientA", inc_text)
        self.assertIn("Client-wise summary", inc_text)
        self.assertIn("Scanned document count", inc_text)
        self.assertIn("Issue document count", inc_text)

        clean = {
            "client": "ClientB",
            "file_id": "F2",
            "docid": "D2",
            "xml_path": str(self.tmp / "D2.xml"),
            "per_section": {
                section: {query: {"count": 0, "hits": []} for query in sr.QUERY_KEYS}
                for section in sr.SECTIONS
            },
            "section_counts": {section: 0 for section in sr.SECTIONS},
            "query_totals": {query: 0 for query in sr.QUERY_KEYS},
            "error": None,
        }
        summary = sr.compute_client_summary([row, clean])
        by_client = {item["client"]: item for item in summary}
        self.assertEqual(by_client["ClientA"]["scanned_document_count"], 1)
        self.assertEqual(by_client["ClientA"]["issue_document_count"], 1)
        self.assertEqual(by_client["ClientB"]["scanned_document_count"], 1)
        self.assertEqual(by_client["ClientB"]["issue_document_count"], 0)
        self.assertEqual(
            sr.CLIENT_SUMMARY_HEADERS,
            [
                "Client",
                "File_id",
                "Docid",
                "Pattern#",
                "Kind",
                "DOI",
                "Tag_L",
                "Attr_L",
                "Tag_R",
                "Attr_R",
                "Sections",
            ],
        )

        patterns = sr.find_kind_v1_patterns([row, clean])
        self.assertEqual(len(patterns), 1)
        self.assertEqual(patterns[0]["kind"], sr.KIND_V1)
        self.assertEqual(patterns[0]["pattern_num"], 1)
        self.assertEqual(patterns[0]["doi"], doi)
        self.assertEqual(patterns[0]["tag_l"], "ext-link")
        self.assertEqual(patterns[0]["tag_r"], "uri")
        self.assertIn("BODY", patterns[0]["sections"])

        cs_html, cs_csv = sr.write_client_summary([row, clean], self.tmp / "reports")
        self.assertTrue(cs_html.is_file())
        self.assertTrue(cs_csv.is_file())
        cs_text = cs_html.read_text(encoding="utf-8")
        self.assertIn("Client-wise summary", cs_text)
        self.assertIn("cause-bar", cs_text)
        self.assertIn("ClientA", cs_text)
        self.assertIn("ClientB", cs_text)
        self.assertIn("pattern-1", cs_text)
        self.assertIn(sr.KIND_V1, cs_text)
        self.assertIn("client-summary-details", cs_text)
        self.assertIn("file-details", cs_text)
        self.assertNotIn("View HTML", cs_text)
        self.assertNotIn("View XML", cs_text)
        csv_text = cs_csv.read_text(encoding="utf-8")
        self.assertIn(
            "Client,File_id,Docid,Pattern#,Kind,DOI,Tag_L,Attr_L,Tag_R,Attr_R,Sections",
            csv_text,
        )
        self.assertIn("ClientA,F1,D1,1,", csv_text)
        self.assertIn(doi, csv_text)
        self.assertIn("ext-link", csv_text)
        self.assertIn(",uri,", csv_text)
        self.assertNotIn("ClientA,1,1", csv_text)

        # Main sectional HTML also embeds the shareable summary panel
        self.assertIn("Client-wise summary", page)
        self.assertIn("Scanned document count", page)
        self.assertIn("pattern-1", page)
        self.assertIn(sr.KIND_V1, page)
        # Text Sample toggle left alone on main report
        self.assertIn("HTML Preview", page)
        self.assertIn("Raw XML", page)
        self.assertIn("previewToggle", page)

        # Unique findings digest: same DOI across two files collapses to one row
        per2 = {
            section: {query: {"count": 0, "hits": []} for query in sr.QUERY_KEYS}
            for section in sr.SECTIONS
        }
        per2["BODY"]["extlink_doi"] = {
            "count": 1,
            "hits": [{
                "tag": "ext-link",
                "text": f"https://doi.org/{doi}",
                "href": f"https://doi.org/{doi}",
                "attrs": 'ext-link-type="doi"',
                "raw_xml": f'<ext-link ext-link-type="doi">{doi}</ext-link>',
            }],
        }
        per2["BODY"]["uri"] = {
            "count": 1,
            "hits": [{
                "tag": "uri",
                "text": f"https://doi.org/{doi}",
                "href": "",
                "attrs": "",
                "raw_xml": f"<uri>https://doi.org/{doi}</uri>",
            }],
        }
        row2 = {
            "client": "ClientA",
            "file_id": "F9",
            "docid": "D9",
            "xml_path": str(self.tmp / "D9.xml"),
            "per_section": per2,
            "section_counts": {section: 0 for section in sr.SECTIONS},
            "query_totals": {query: 0 for query in sr.QUERY_KEYS},
            "error": None,
        }
        findings = sr.compute_unique_findings([row, row2, clean])
        self.assertEqual(len(findings), 1)
        self.assertEqual(findings[0]["num"], 1)
        self.assertEqual(findings[0]["kind"], sr.KIND_V1)
        self.assertEqual(findings[0]["doi"], doi)
        self.assertEqual(findings[0]["doi_or_sample"], doi)
        self.assertEqual(findings[0]["issue_docs"], 2)
        self.assertEqual(findings[0]["clients"], ["ClientA"])
        self.assertEqual(findings[0]["file_id_count"], 2)
        self.assertIn("F1", findings[0]["example_file_ids"])
        self.assertIn("F9", findings[0]["example_file_ids"])
        self.assertIn("ext-link", findings[0]["pattern"])
        self.assertIn("uri", findings[0]["pattern"])

        uf_html, uf_csv, uf_txt = sr.write_unique_findings(
            [row, row2, clean], self.tmp / "reports"
        )
        self.assertTrue(uf_html.is_file())
        self.assertTrue(uf_csv.is_file())
        self.assertTrue(uf_txt.is_file())
        uf_page = uf_html.read_text(encoding="utf-8")
        self.assertIn("Unique Findings Digest", uf_page)
        self.assertIn("Plain-text body", uf_page)
        self.assertIn(doi, uf_page)
        self.assertIn(sr.KIND_V1, uf_page)
        csv_uf = uf_csv.read_text(encoding="utf-8")
        self.assertIn(
            "#,Kind,Pattern (tag/attrs),DOI/sample,Clients,Issue docs,Example file-id(s)",
            csv_uf,
        )
        self.assertIn(doi, csv_uf)
        self.assertIn("ClientA", csv_uf)
        mail = uf_txt.read_text(encoding="utf-8")
        self.assertIn("Unique Findings Digest", mail)
        self.assertIn(doi, mail)
        self.assertIn("Full reports", mail)
        self.assertIn(str(sr.REPORT_VERSION), mail)
        body2 = sr.format_unique_findings_mail_body(findings)
        self.assertIn("Unique Findings Digest", body2)
        self.assertIn(doi, body2)
        self.assertIn("	", body2)

        # Fallback key when DOI empty: kind + L/R tag+attr signature
        no_doi = dict(findings[0])
        no_doi["doi"] = ""
        no_doi["doi_or_sample"] = ""
        # synthesize via pattern dicts directly through key helper
        fake = {
            "kind": sr.KIND_V1,
            "doi": "",
            "tag_l": "ext-link",
            "attr_l": 'ext-link-type="doi" href="https://example/x"',
            "tag_r": "uri",
            "attr_r": "",
            "sample_l": "sample-left",
            "sample_r": "",
            "client": "ClientZ",
            "file_id": "FZ",
            "docid": "DZ",
            "xml_path": "z.xml",
        }
        key = sr._unique_finding_key(fake)
        self.assertEqual(key[0], "sig")
        self.assertIn(sr.KIND_V1, key)
        self.assertNotIn("href=", key[-1])
        self.assertIn("ext-link", key[-1])


if __name__ == "__main__":
    unittest.main()
