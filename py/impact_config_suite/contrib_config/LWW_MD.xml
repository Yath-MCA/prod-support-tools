<pi-config client="LWW" shortcode="MD" dtd="JATS" version="1" status="draft">
  <!-- pos="inner": PI inside the element, at its end.  pos="after": PI right after the element. -->
  <contrib>
    <elements>
      <prefix         allowed="no"/>
      <degrees        allowed="yes"/>
      <suffix         allowed="no"/>
      <role           allowed="yes"/>
      <author-comment allowed="yes"/>
      <altername      allowed="yes"/>
      <collab         allowed="yes"/>
      <on-behalf-of   allowed="yes"/>
    </elements>
    <ques>
      <author-notes allowed="no"/>
      <corresp      allowed="no"/>
      <aff          allowed="yes"/>
    </ques>
    <separators>
      <given-names      value="&#x00A0;" pos="inner"/>
      <between-xrefs    value=","        pos="after"/>
      <between-contribs value=","        pos="after" contribs="3+"/>
      <between-contribs value="and"      pos="after" contribs="3+" when="last-before"/>
      <between-contribs value="and"      pos="after" contribs="2"  when="last-before"/>
      <between-contribs value=""         pos="after" when="last"/>
    </separators>
  </contrib>
</pi-config>
