"""

TOGGLE = (
    '<div class="toggle" role="group" aria-label="Column view">'
    '<button type="button" data-view="preview" class="on">Preview HTML</button>'
    '<button type="button" data-view="raw">Raw XML</button></div>'
)

LEGEND = (
    '<div class="legend"><span class="pi">text</span> restored from pistart &middot; '
    '<span class="pi bad">text</span> differs from the most common value at the same position &middot; '
    '<span class="pi miss">&#9888;</span> pistart missing where other files have it</div>'
)

JS = """<script>
(function () {
  var h = document.getElementById('top');
  function fit() { document.documentElement.style.setProperty('--hh', h.offsetHeight + 'px'); }
  fit(); window.addEventListener('resize', fit); window.addEventListener('load', fit);
  document.querySelectorAll('.toggle button').forEach(function (b) {
    b.addEventListener('click', function () {
      document.body.setAttribute('data-view', b.dataset.view);
      document.querySelectorAll('.toggle button').forEach(function (x) {
        x.classList.toggle('on', x === b);
      });
    });
  });
})();
</script>"""


def page(title: str, chips: list, body: str, toggle: bool = False) -> str:
    """chips: list of (label, value, style) with style in '', 'warn', 'good'."""
    chips_html = "".join(
        f'<span class="chip {style}"><b>{esc(label)}</b> {esc(str(value))}</span>'
        for label, value, style in chips
    )
    return (
        '<!DOCTYPE html>\n<html lang="en"><head><meta charset="utf-8">'
        '<meta name="viewport" content="width=device-width, initial-scale=1">'
        f"<title>{esc(title)}</title><style>{CSS}</style></head>"
        '<body data-view="preview">'
        f'<header id="top"><div class="ttl">{esc(title)}</div>'
        f'<div class="chips">{chips_html}</div>{TOGGLE if toggle else ""}</header>'
        f"<main>{LEGEND}{body}</main>{JS}</body></html>"
    )


def issue_chip(n: int) -> tuple:
    return ("Consistency issues", n, "warn" if n else "good")


def now() -> str:
    return datetime.now().strftime("%Y-%m-%d %H:%M")


def write_doc_outputs(row: dict, client: str, shortcode: str, ctx: Ctx, issues: list):
    folder: Path = row["folder"]
    (folder / OUT_XML).write_text(row["raw_group"], encoding="utf-8")

    by_n: dict = defaultdict(list)
    for i in issues:
        by_n[i["n"]].append(i["text"])

    trs = []
    for n, c in enumerate(row["contribs"], 1):
        if by_n[n]:
            chk = "<ul>" + "".join(f"<li>{esc(t)}</li>" for t in by_n[n]) + "</ul>"
        else:
            chk = '<span class="ok">OK</span>'
        trs.append(f'<tr><td>{n}</td><td>{render(c, ctx)}</td><td class="chk">{chk}</td></tr>')

    body = (
        "<table class=\"files\"><tr><th>#</th><th>Contrib</th><th>Consistency</th></tr>"
        + "".join(trs)
        + "</table>"
    )
    chips = [
        ("Docid", row["docid"], ""),
        ("Client", client, ""),
        ("Shortcode", shortcode, ""),
        ("Contribs", len(row["contribs"]), ""),
        issue_chip(len(issues)),
        ("Generated", now(), ""),
    ]
    title = row["file_id"] or row["docid"]
    (folder / OUT_HTML).write_text(page(title, chips, body), encoding="utf-8")


def pick_cells(contribs, raws, ctx: Ctx) -> list:
    """
    first / last-before / last as (preview_html, raw_xml) pairs,
    None where it would only repeat another column.
    """
    n = len(contribs)

    def cell(i):
        raw = raws[i] if i < len(raws) else "(raw xml not available)"
        return render(contribs[i], ctx), raw

    out = []
    for role, _ in ROLES:
        i = role_index(n, role)
        out.append(cell(i) if i is not None else None)
    return out


def build_report(client: str, shortcode: str, rows: list[dict], report_dir: Path, stats):
    rows = sorted(rows, key=lambda r: (r["file_id"] or r["docid"]).lower())
    trs = []
    for r in rows:
        fid = esc(r["file_id"] or r["docid"])
        if r["preview_rel"]:
            fid = f'<a href="{esc(r["preview_rel"])}">{fid}</a>'
        if r["issues"]:
            tips = [i["text"] for i in r["issues"][:8]]
            if len(r["issues"]) > 8:
                tips.append(f"... +{len(r['issues']) - 8} more")
            fid += (
                f' <span class="badge" title="{esc_attr(chr(10).join(tips))}">'
                f'&#9888; {len(r["issues"])}</span>'
            )
        did = f'<td class="docid">{esc(r["docid"])}</td>'
        rid = esc(row_id(r["docid"]))
        if r["error"]:
            trs.append(
                f'<tr id="{rid}"><td class="fid">{fid}</td>{did}'
                f'<td class="err" colspan="3">{esc(r["error"])}</td></tr>'
            )
            continue
        cells = "".join(
            (
                f'<td><div class="v-preview">{c[0]}</div>'
                f'<div class="v-raw"><pre class="raw">{esc(c[1])}</pre></div>'
                f'{cell_tags(r, role)}</td>'
            )
            if c
            else '<td class="na">-</td>'
            for (role, _), c in zip(ROLES, r["cells"])
        )
        trs.append(f'<tr id="{rid}"><td class="fid">{fid}</td>{did}{cells}</tr>')

    body = (
        stats_html(stats)
        + '<table class="files"><tr><th>File ID</th><th>Docid</th>'
        "<th>First contrib</th><th>Last before</th><th>Last contrib</th></tr>"
        + "".join(trs)
        + "</table>"
    )

    good = [r for r in rows if r["contribs"]]
    n_issues = sum(len(r["issues"]) for r in good)
    off = off_pattern_rows(good)
    chips = [
        ("Client", client, ""),
        ("Project shortcode", shortcode, ""),
        ("Documents", len(rows), ""),
        ("Contribs checked", sum(len(r["contribs"]) for r in good), ""),
        ("Off-pattern files", f"{len(off)}/{len(good)}", "warn" if off else "good"),
        issue_chip(n_issues),
    ]
    failed = len(rows) - len(good)
    if failed:
        chips.append(("Failed docs", failed, "warn"))
    chips.append(("Generated", now(), ""))

    out = report_dir / f"{safe_name(client)}_{safe_name(shortcode)}_contrib.html"
    out.write_text(
        page(f"{client} / {shortcode} - contrib report", chips, body, toggle=True),
        encoding="utf-8",
    )
    return out, len(off)


# ------------------------------------------------------------- one document

def read_doc(base: Path, docid: str, item: dict, meta: dict, log: LogFn = _noop_log) -> dict:
    """Read + parse one document. Never raises; problems go into row['error']."""
    row = {
        "docid": docid,
        "file_id": meta.get("file-id", ""),
        "folder": doc_folder(base, docid, item, meta),
        "preview_rel": "",
        "cells": None,
        "error": None,
        "contribs": None,
        "raws": [],
        "gaps": [],
        "raw_group": "",
        "issues": [],
        "cmp_gaps": [],
        "seqs": [],
        "pat": {},
    }
    folder = row["folder"]
    if not folder.is_dir():
        row["error"] = f"folder not found: {folder}"
        log(f"[MISSING] {docid} - {row['error']}")
        return row

    src, raw = extract_contrib_groups(folder, base, item)
    if not raw:
        row["error"] = "no <contrib-group> found in any xml in folder"
        log(f"[NO CONTRIB] {docid} - {row['error']}")
        return row

    try:
        contribs = parse_contribs(raw)
    except ET.ParseError as e:
        row["error"] = f"contrib-group parse error: {e}"
        log(f"[FAILED] {docid} - {row['error']}")
        return row

    if not contribs:
        row["error"] = "<contrib-group> has no <contrib>"
        log(f"[EMPTY] {docid} - {row['error']}")
        return row

    raws = raw_contribs(raw)
    if len(raws) != len(contribs):
        log(f"[WARN] {docid} - raw/parsed contrib count differs ({len(raws)} vs {len(contribs)})")

    row["contribs"] = contribs
    row["raws"] = raws
    row["raw_group"] = raw
    row["src"] = src.name
    row["gaps"] = [analyze(c) for c in contribs]
    row["cmp_gaps"] = [comparable(g, i == len(contribs) - 1) for i, g in enumerate(row["gaps"])]
    row["seqs"] = [pi_sequences(g) for g in row["gaps"]]
    return row


# ------------------------------------------------------ one client + shortcode

def process_group(
    base: Path,
    docs: dict,
    metas: dict,
    client: str,
    shortcode: str,
    docids: list,
    log: LogFn = _noop_log,
    cancel_check: CancelFn = _noop_cancel,
) -> dict:
    """Build per-doc outputs and the ONE report for a client + shortcode."""
    report_dir = base / REPORT_DIR / RUN_DTD
    report_dir.mkdir(parents=True, exist_ok=True)

    rows = []
    for d in docids:
        if cancel_check():
            break
        rows.append(read_doc(base, d, docs[d], metas[d], log=log))
    good = [r for r in rows if r["contribs"]]

    expected = expected_values(gl for r in good for gl in r["cmp_gaps"])
    stats = build_stats(good) if good else None

    total_issues = 0
    for r in good:
        if cancel_check():
            break
        ctx, issues = build_ctx(r["cmp_gaps"], expected)
        r["issues"] = issues
        write_doc_outputs(r, client, shortcode, ctx, issues)
        r["cells"] = pick_cells(r["contribs"], r["raws"], ctx)
        r["preview_rel"] = Path(os.path.relpath(r["folder"] / OUT_HTML, report_dir)).as_posix()
        total_issues += len(issues)
        tag = f", {len(issues)} consistency issue(s)" if issues else ""
        log(f"[OK] {r['docid']} ({r['src']}) - {len(r['contribs'])} contribs{tag}")

    cancelled_mid = cancel_check()
    # Only write the shortcode report when we finished every doc (or had none).
    if cancelled_mid and len(rows) < len(docids):
        log(f"[CANCELLED] {client}/{shortcode} stopped mid-shortcode "
            f"({len(rows)}/{len(docids)} docs read) — not marked filled")
        return {
            "generated_at": now(),
            "report": "",
            "documents": len(rows),
            "failed": len(rows) - len(good),
            "off_pattern_files": 0,
            "consistency_issues": total_issues,
            "cancelled": True,
            "docids": {
                r["docid"]: {
                    "file-id": r["file_id"],
                    "contribs": len(r["contribs"]) if r["contribs"] else 0,
                    "status": "ok" if r["contribs"] else f"error: {r['error']}",
                }
                for r in rows
            },
        }

    out, n_off = build_report(client, shortcode, rows, report_dir, stats)
    log(f"[REPORT] {out.relative_to(base)} ({len(rows)} docs, {n_off} off-pattern)")

    return {
        "generated_at": now(),
        "report": out.relative_to(base).as_posix(),
        "documents": len(rows),
        "failed": len(rows) - len(good),
        "off_pattern_files": n_off,
        "consistency_issues": total_issues,
        "cancelled": False,
        "docids": {
            r["docid"]: {
                "file-id": r["file_id"],
                "contribs": len(r["contribs"]) if r["contribs"] else 0,
                "status": "ok" if r["contribs"] else f"error: {r['error']}",
            }
            for r in rows
        },
    }


# ------------------------------------------------ what is in meta / what is done

def dtd_of(item: dict, meta: dict) -> str:
    return meta.get("dtd") or item.get("folder", "").split("/", 1)[0]


def build_index(docs: dict, metas: dict) -> dict:
    """{client: {shortcode: [docid, ...]}} for RUN_DTD documents only."""
    index: dict = {}
    for docid, meta in metas.items():
        item = docs.get(docid)
        if item is None or dtd_of(item, meta) != RUN_DTD:
            continue
        client = meta.get("client") or "unknown"
        shortcode = meta.get("project-shortcode") or "unknown"
        index.setdefault(client, {}).setdefault(shortcode, []).append(docid)
    return index


def load_done(base: Path) -> dict:
    p = base / DONE_NAME
    return load_json(p) if p.exists() else {}


def save_done(base: Path, data: dict):
    p = base / DONE_NAME
    tmp = p.with_suffix(".json.tmp")
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
    os.replace(tmp, p)  # never leaves a half written file behind


def done_entry(done: dict, client: str, shortcode: str):
    return done.get(RUN_DTD, {}).get(client, {}).get(shortcode)


def status_of(done: dict, client: str, shortcode: str, docids: list):
    """('new'|'update'|'done', number of docids not recorded yet)"""
    e = done_entry(done, client, shortcode)
    if not e:
        return "new", 0
    seen = e.get("docids", {})
    fresh = [d for d in docids if d not in seen]
    return ("update", len(fresh)) if fresh else ("done", 0)


# ----------------------------------------------------------------- questions

def parse_choice(raw: str, options: list):
    """'1,3' or 'LWW plos' -> matching option names, None if anything is unknown."""
    lookup = {o.lower(): o for o in options}
    out = []
    for part in re.split(r"[,\s]+", raw.strip()):
        if not part:
            continue
        if part.isdigit() and 1 <= int(part) <= len(options):
            name = options[int(part) - 1]
        elif part.lower() in lookup:
            name = lookup[part.lower()]
        else:
            return None
        if name not in out:
            out.append(name)
    return out


def cnt(n: int, word: str = "doc") -> str:
    return f"{n} {word}{'' if n == 1 else 's'}"


def status_note(done: dict, client: str, shortcode: str, docids: list) -> str:
    st, n = status_of(done, client, shortcode, docids)
    if st == "new":
        return "not filled"
    if st == "update":
        return f"update (+{n} new doc{'' if n == 1 else 's'})"
    e = done_entry(done, client, shortcode)
    bad = f", {e['failed']} failed" if e.get("failed") else ""
    return f"filled {e.get('generated_at', '')}{bad}"


def build_overview(docs: dict, metas: dict, index: dict, done: dict) -> dict:
    """Structured overview for GUI (and CLI formatting).

    Returns dict with:
      dtd, clients, shortcodes, docs, unique_shortcode_names,
      filled, not_filled, update,
      client_rows: [{client, shortcodes, docs, filled, items:[{shortcode, docs, status, status_key, fresh}]}],
      ignored_notes: [str, ...]
    """
    clients = sorted(index, key=str.lower)
    pairs = [(c, sc) for c in clients for sc in sorted(index[c], key=str.lower)]
    n_docs = sum(len(v) for scs in index.values() for v in scs.values())
    unique_sc = {sc for _, sc in pairs}
    states = Counter(status_of(done, c, sc, index[c][sc])[0] for c, sc in pairs)

    client_rows = []
    for c in clients:
        scs = index[c]
        filled_n = sum(status_of(done, c, sc, ids)[0] == "done" for sc, ids in scs.items())
        docs_c = sum(len(v) for v in scs.values())
        items = []
        for sc in sorted(scs, key=str.lower):
            st, fresh = status_of(done, c, sc, scs[sc])
            items.append({
                "shortcode": sc,
                "docs": len(scs[sc]),
                "docids": list(scs[sc]),
                "status_key": st,  # new | update | done
                "fresh": fresh,
                "status": status_note(done, c, sc, scs[sc]),
            })
        client_rows.append({
            "client": c,
            "shortcodes": len(scs),
            "docs": docs_c,
            "filled": filled_n,
            "items": items,
        })

    notes = []
    others = Counter(
        dtd_of(docs[d], m) or "?" for d, m in metas.items() if d in docs and dtd_of(docs[d], m) != RUN_DTD
    )
    if others:
        notes.append("not " + RUN_DTD + ": " + ", ".join(f"{k} {cnt(v)}" for k, v in sorted(others.items())))
    no_meta = sum(1 for d in docs if d not in metas)
    if no_meta:
        notes.append(f"{cnt(no_meta)} without a {META_NAME} entry")
    blank = sum(len(v) for sc_map in index.values() for sc, v in sc_map.items() if sc == "unknown")
    blank += sum(len(v) for c, sc_map in index.items() if c == "unknown" for v in sc_map.values())
    if blank:
        notes.append(f"{cnt(blank)} with a blank client or shortcode (grouped as 'unknown')")

    return {
        "dtd": RUN_DTD,
        "clients": len(clients),
        "shortcodes": len(pairs),
        "docs": n_docs,
        "unique_shortcode_names": len(unique_sc),
        "filled": states["done"],
        "not_filled": states["new"],
        "update": states["update"],
        "client_rows": client_rows,
        "ignored_notes": notes,
        "pairs": pairs,
    }


def format_overview_text(overview: dict) -> str:
    """Render build_overview() result as the CLI-style text block."""
    lines = []
    extra = ""
    if overview["unique_shortcode_names"] != overview["shortcodes"]:
        extra = f"  ({overview['unique_shortcode_names']} unique shortcode names)"
    lines.append(
        f"{overview['dtd']} overview:  {overview['clients']} clients | "
        f"{overview['shortcodes']} shortcodes | {overview['docs']} docs{extra}"
    )
    lines.append(
        f"  filled: {overview['filled']}  |  not filled: {overview['not_filled']}  |  "
        f"update (new docs): {overview['update']}"
    )
    lines.append("")
    for row in overview["client_rows"]:
        c = row["client"]
        lines.append(
            f"  {c}   {row['shortcodes']} shortcodes, {row['docs']} docs   "
            f"({row['filled']}/{row['shortcodes']} filled)"
        )
        for item in row["items"]:
            lines.append(
                f"      {item['shortcode']:<14}{item['docs']:>6} docs   [{item['status']}]"
            )
    if overview["ignored_notes"]:
        lines.append("")
        lines.append("  ignored / check: " + "; ".join(overview["ignored_notes"]))
    return "\n".join(lines)


def print_overview(docs: dict, metas: dict, index: dict, done: dict, log: LogFn = _noop_log):
    """Unique counts Clients -> Shortcodes and whether each is already filled."""
    overview = build_overview(docs, metas, index, done)
    log("\n" + format_overview_text(overview))


def pending_pairs(clients: list, index: dict, done: dict, regenerate_all: bool = False) -> list:
    """(client, shortcode) pairs that are not filled, or all if regenerate_all."""
    pairs = []
    for c in clients:
        for sc in sorted(index[c], key=str.lower):
            st, _ = status_of(done, c, sc, index[c][sc])
            if regenerate_all or st != "done":
                pairs.append((c, sc))
    return pairs


def choose_clients(index: dict, done: dict) -> list:
    clients = sorted(index, key=str.lower)
    print(f"\n{RUN_DTD} clients:")
    for i, c in enumerate(clients, 1):
        scs = index[c]
        pending = sum(status_of(done, c, sc, ids)[0] != "done" for sc, ids in scs.items())
        n_docs = sum(len(v) for v in scs.values())
        tail = f"{pending} to generate" if pending else "all filled"
        print(f"  {i}) {c:<14}{len(scs):>4} shortcodes{n_docs:>8} docs   {tail}")
    while True:
        raw = input("Client (number/name, comma for several, 'all'): ").strip()
        if raw.lower() == "all":
            return clients
        picked = parse_choice(raw, clients)
        if picked:
            return picked
        print("  not recognised, try again")


def choose_shortcodes(clients: list, index: dict, done: dict) -> list:
    """Return the (client, shortcode) pairs to generate."""
    scs = None
    if len(clients) == 1:
        c = clients[0]
        scs = sorted(index[c], key=str.lower)
        print(f"\n{RUN_DTD} / {c} shortcodes:")
        for i, sc in enumerate(scs, 1):
            note = status_note(done, c, sc, index[c][sc])
            print(f"  {i}) {sc:<14}{len(index[c][sc]):>6} docs   [{note}]")
        prompt = (
            "Shortcode (number/name, comma for several; Enter = all not filled/updated; "
            "'all' = regenerate everything): "
        )
    else:
        prompt = (
            f"Shortcodes for {', '.join(clients)} (Enter = all not filled/updated; "
            "'all' = regenerate everything): "
        )

    while True:
        raw = input(prompt).strip()
        low = raw.lower()
        if low in ("", "new", "all"):
            pairs = []
            for c in clients:
                for sc in sorted(index[c], key=str.lower):
                    st, _ = status_of(done, c, sc, index[c][sc])
                    if low == "all" or st != "done":
                        pairs.append((c, sc))
            return pairs
        picked = parse_choice(raw, scs) if scs else None
        if picked:
            pairs = []
            for sc in picked:
                st, _ = status_of(done, clients[0], sc, index[clients[0]][sc])
                if st == "done":
                    ans = input(f"  {sc} is already filled. Regenerate? [y/N]: ").strip().lower()
                    if ans != "y":
                        continue
                pairs.append((clients[0], sc))
            return pairs
        print("  not recognised, try again")


# ---------------------------------------------------------------------- main

def ask_delay(label: str, default: float) -> float:
    while True:
        raw = input(f"{label} in seconds [{default:g}]: ").strip()
        if not raw:
            return default
        try:
            v = float(raw)
            if v >= 0:
                return v
        except ValueError:
            pass
        print("  enter a number of seconds (0 = no pause)")



def pause(seconds: float, why: str, log: LogFn = _noop_log, cancel_check: CancelFn = _noop_cancel):
    """Sleep in small slices so Cancel / Ctrl+C can interrupt promptly."""
    if seconds <= 0:
        return
    log(f"  ... pausing {seconds:g}s before {why} (Cancel / Ctrl+C to stop)")
    end = time.time() + seconds
    while time.time() < end:
        if cancel_check():
            return
        time.sleep(min(0.25, max(0.0, end - time.time())))


def run_contrib_extract(
    root: Path | str,
    clients: Optional[Iterable[str]] = None,
    shortcodes: Optional[Iterable[tuple[str, str]]] = None,
    delay_sc: float = DELAY_SHORTCODE_SEC,
    delay_cl: float = DELAY_CLIENT_SEC,
    regenerate_all: bool = False,
    log_callback: LogFn = _noop_log,
    progress_callback: ProgressFn = _noop_progress,
    cancel_check: CancelFn = _noop_cancel,
) -> dict:
    """Batch-run contrib extraction for selected clients/shortcodes.

    Parameters
    ----------
    root : project root containing documents.json + meta.json
    clients : optional client name filter (used when shortcodes is None)
    shortcodes : optional explicit list of (client, shortcode) pairs in run order
    delay_sc / delay_cl : pause seconds between shortcodes / clients (0 = none)
    regenerate_all : when shortcodes is None, include already-filled shortcodes
    log_callback / progress_callback / cancel_check : GUI/CLI hooks

    Returns summary dict with keys: finished, total, cancelled, done_path, overview (pre-run).
    """
    base = Path(root)
    log = log_callback or _noop_log
    progress = progress_callback or _noop_progress
    cancelled = cancel_check or _noop_cancel

    if not (base / DOCS_NAME).exists() or not (base / META_NAME).exists():
        raise FileNotFoundError(f"Missing {DOCS_NAME} or {META_NAME} in {base}")

    docs = load_json(base / DOCS_NAME)
    metas = load_json(base / META_NAME)
    index = build_index(docs, metas)
    if not index:
        raise ValueError(f"No {RUN_DTD} documents found in {META_NAME}")

    done = load_done(base)
    overview = build_overview(docs, metas, index, done)

    if shortcodes is not None:
        pairs = [(c, sc) for c, sc in shortcodes]
    else:
        client_list = list(clients) if clients is not None else sorted(index, key=str.lower)
        for c in client_list:
            if c not in index:
                raise KeyError(f"Unknown client: {c}")
        pairs = pending_pairs(client_list, index, done, regenerate_all=regenerate_all)

    # Validate pairs and keep only those that exist
    valid = []
    for c, sc in pairs:
        if c not in index or sc not in index[c]:
            log(f"[SKIP] unknown pair {c}/{sc}")
            continue
        valid.append((c, sc))
    pairs = valid

    total = len(pairs)
    if total == 0:
        log(
            f"\nNothing to generate (everything selected is already in {DONE_NAME}; "
            "pick filled shortcodes or enable regenerate-all)."
        )
        return {
            "finished": [],
            "total": 0,
            "cancelled": False,
            "done_path": str(base / DONE_NAME),
            "overview": overview,
            "last_report": None,
        }

    left: Counter = Counter(c for c, _ in pairs)
    finished = []
    last_report = None
    was_cancelled = False

    try:
        for i, (client, shortcode) in enumerate(pairs, 1):
            if cancelled():
                was_cancelled = True
                log(f"\nStopped by user. Finished shortcodes are already saved in {DONE_NAME}")
                break

            ids = index[client][shortcode]
            msg = f"=== [{i}/{total}] {RUN_DTD} / {client} / {shortcode} ({cnt(len(ids))}) ==="
            log(f"\n{msg}")
            progress(i - 1, total, msg)

            entry = process_group(
                base, docs, metas, client, shortcode, ids,
                log=log, cancel_check=cancelled,
            )
            if cancelled():
                # Still record if we fully processed and not all-failed
                was_cancelled = True

            if entry.get("cancelled"):
                log(f"[SKIP RECORD] {shortcode} cancelled mid-run, not marked as filled")
            elif entry["failed"] == entry["documents"] and entry["documents"] > 0:
                log(f"[SKIP RECORD] every document failed, {shortcode} not marked as filled")
            elif entry["documents"] == 0:
                log(f"[SKIP RECORD] no documents processed for {shortcode}")
            else:
                done.setdefault(RUN_DTD, {}).setdefault(client, {})[shortcode] = entry
                save_done(base, done)
                if entry.get("report"):
                    last_report = str(base / entry["report"])

            finished.append((client, shortcode, entry))
            progress(i, total, f"{client}/{shortcode} done")

            left[client] -= 1
            if left[client] == 0:
                log(f"[CLIENT COMPLETE] {client}")
            if i < total and not cancelled():
                nxt_client, nxt_sc = pairs[i]
                if nxt_client != client:
                    pause(delay_cl, f"client {nxt_client}", log=log, cancel_check=cancelled)
                else:
                    pause(delay_sc, f"shortcode {nxt_client}/{nxt_sc}", log=log, cancel_check=cancelled)
            if cancelled() and i < total:
                was_cancelled = True
                log(f"\nStopped by user. Finished shortcodes are already saved in {DONE_NAME}")
                break
    except KeyboardInterrupt:
        was_cancelled = True
        log(f"\nStopped by user. Finished shortcodes are already saved in {DONE_NAME}")

    log(f"\nSummary ({len(finished)}/{total} shortcodes processed):")
    for client, shortcode, e in finished:
        log(
            f"  {client} / {shortcode:<12} {e['documents']:>5} docs  {e['failed']:>3} failed  "
            f"{e['off_pattern_files']:>3} off-pattern  -> {e['report']}"
        )
    log(f"Progress saved in {DONE_NAME}")

    return {
        "finished": finished,
        "total": total,
        "cancelled": was_cancelled,
        "done_path": str(base / DONE_NAME),
        "overview": overview,
        "last_report": last_report,
    }


def load_project(root: Path | str) -> tuple[Path, dict, dict, dict, dict]:
    """Load documents.json, meta.json, index, and meta-contrib.json for a project root."""
    base = Path(root)
    docs = load_json(base / DOCS_NAME)
    metas = load_json(base / META_NAME)
    index = build_index(docs, metas)
    done = load_done(base)
    return base, docs, metas, index, done


def main():
    base = Path(input("Project Folder: ").strip().strip('"'))
    if not (base / DOCS_NAME).exists() or not (base / META_NAME).exists():
        print(f"Missing {DOCS_NAME} or {META_NAME} in {base}")
        return

    docs = load_json(base / DOCS_NAME)
    metas = load_json(base / META_NAME)
    index = build_index(docs, metas)
    if not index:
        print(f"No {RUN_DTD} documents found in {META_NAME} (is the 'dtd' field filled in?)")
        return

    done = load_done(base)
    print_overview(docs, metas, index, done)

    clients = choose_clients(index, done)
    pairs = choose_shortcodes(clients, index, done)  # already ordered client -> shortcode
    if not pairs:
        print(
            "\nNothing to generate (everything selected is already in "
            f"{DONE_NAME}; pick it by number or type 'all' to redo)."
        )
        return

    total = len(pairs)
    delay_sc = delay_cl = 0.0
    if total > 1:
        print()
        delay_sc = ask_delay("Pause between shortcodes", DELAY_SHORTCODE_SEC)
        if len({c for c, _ in pairs}) > 1:
            delay_cl = ask_delay("Pause between clients", DELAY_CLIENT_SEC)

    run_contrib_extract(
        base,
        shortcodes=pairs,
        delay_sc=delay_sc,
        delay_cl=delay_cl,
        log_callback=print,
    )


if __name__ == "__main__":
    main()
